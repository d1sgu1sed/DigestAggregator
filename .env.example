# Скопируйте в .env и укажите свои значения: cp .env.example .env
# Файл читают приложение (app/config.py) и docker-compose.yml.
# Формат: KEY=value, без кавычек и пробелов вокруг "=".

# Рабочая БД (сервис db)
POSTGRES_USER=news_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=news
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Тестовая БД (сервис db_test)
TEST_POSTGRES_USER=news_test_user
TEST_POSTGRES_PASSWORD=changeme
TEST_POSTGRES_DB=news_test
TEST_POSTGRES_HOST=127.0.0.1
TEST_POSTGRES_PORT=5433
