# Скопируйте в .env и укажите свои значения: cp .env.example .env
# Файл читают приложение (app/config.py) и docker-compose.yml.
# Формат: KEY=value, без кавычек и пробелов вокруг "=".

# Рабочая БД (сервис db)
POSTGRES_USER=news_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=news
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Тестовая БД (сервис db_test)
TEST_POSTGRES_USER=news_test_user
TEST_POSTGRES_PASSWORD=changeme
TEST_POSTGRES_DB=news_test
TEST_POSTGRES_HOST=127.0.0.1
TEST_POSTGRES_PORT=5433

# Необязательно: RSS-лента Google Alerts
# GOOGLE_ALERTS_FEED_URL=https://www.google.com/alerts/feeds/<id>/<id>

# Планировщик сбора (работает внутри API-процесса)
SCHEDULER_ENABLED=true
COLLECT_INTERVAL_MINUTES=5

# LLM для описаний новостей (Ollama)
# Модель по умолчанию: gemma3:4b (точнее) или qwen3:4b-instruct (быстрее)
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=gemma3:4b
LLM_TIMEOUT_SECONDS=120
# Сколько свежих новостей одного источника за день попадает в LLM-дайджест
LLM_DIGEST_PER_SOURCE_PER_DAY=10
